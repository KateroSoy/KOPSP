# Backend Server Configuration
NODE_ENV=production
PORT=3001
APP_ORIGIN=https://kopsp.vercel.app
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
ADMIN_CODE=ADM-001
ALLOW_DEMO_FALLBACK=false
FORCE_DEMO_FALLBACK=false

# Database Configuration (Supabase)
DATABASE_URL=postgresql://postgres.your-project-ref:your-supabase-password@aws-1-your-region.pooler.supabase.com:6543/postgres?schema=public&sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres?schema=public&sslmode=require

# Frontend Configuration (Point to your backend API)
# Deploy backend separately and set this URL
VITE_API_BASE_URL=https://your-backend-domain.com
# Or if backend is on Railway/Render:
# VITE_API_BASE_URL=https://your-app.railway.app

VITE_API_PROXY_TARGET=
RUN_DB_TESTS=false

